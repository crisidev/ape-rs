+#[cfg(cosmo)]
+pub fn decode_error_kind(errno: i32) -> io::ErrorKind {
+    use io::ErrorKind::*;
+    // SAFETY (cosmo patch): all COSMO_E* are extern const errno_t
+    // symbols in cosmo's libc, initialised to the host OS's numeric
+    // value at load time. Reading is always safe.
+    let e = errno as libc::c_int;
+    unsafe {
+        if e == COSMO_E2BIG { return ArgumentListTooLong; }
+        if e == COSMO_EADDRINUSE { return AddrInUse; }
+        if e == COSMO_EADDRNOTAVAIL { return AddrNotAvailable; }
+        if e == COSMO_EBUSY { return ResourceBusy; }
+        if e == COSMO_ECONNABORTED { return ConnectionAborted; }
+        if e == COSMO_ECONNREFUSED { return ConnectionRefused; }
+        if e == COSMO_ECONNRESET { return ConnectionReset; }
+        if e == COSMO_EDEADLK { return Deadlock; }
+        if e == COSMO_EDQUOT { return QuotaExceeded; }
+        if e == COSMO_EEXIST { return AlreadyExists; }
+        if e == COSMO_EFBIG { return FileTooLarge; }
+        if e == COSMO_EHOSTUNREACH { return HostUnreachable; }
+        if e == COSMO_EINTR { return Interrupted; }
+        if e == COSMO_EINVAL { return InvalidInput; }
+        if e == COSMO_EISDIR { return IsADirectory; }
+        if e == COSMO_ELOOP { return FilesystemLoop; }
+        if e == COSMO_ENOENT { return NotFound; }
+        if e == COSMO_ENOMEM { return OutOfMemory; }
+        if e == COSMO_ENOSPC { return StorageFull; }
+        if e == COSMO_ENOSYS { return Unsupported; }
+        if e == COSMO_EMLINK { return TooManyLinks; }
+        if e == COSMO_ENAMETOOLONG { return InvalidFilename; }
+        if e == COSMO_ENETDOWN { return NetworkDown; }
+        if e == COSMO_ENETUNREACH { return NetworkUnreachable; }
+        if e == COSMO_ENOTCONN { return NotConnected; }
+        if e == COSMO_ENOTDIR { return NotADirectory; }
+        if e == COSMO_ENOTEMPTY { return DirectoryNotEmpty; }
+        if e == COSMO_EPIPE { return BrokenPipe; }
+        if e == COSMO_EROFS { return ReadOnlyFilesystem; }
+        if e == COSMO_ESPIPE { return NotSeekable; }
+        if e == COSMO_ESTALE { return StaleNetworkFileHandle; }
+        if e == COSMO_ETIMEDOUT { return TimedOut; }
+        if e == COSMO_ETXTBSY { return ExecutableFileBusy; }
+        if e == COSMO_EXDEV { return CrossesDevices; }
+        if e == COSMO_EINPROGRESS { return InProgress; }
+        if e == COSMO_EOPNOTSUPP { return Unsupported; }
+        if e == COSMO_EACCES || e == COSMO_EPERM { return PermissionDenied; }
+        if e == COSMO_EAGAIN { return WouldBlock; }
+    }
+    Uncategorized
+}
