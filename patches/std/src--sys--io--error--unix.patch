+// cosmo patch: cosmopolitan does not normalise the numeric value of
+// `errno` across host OSes — on macOS/FreeBSD/OpenBSD/Windows the
+// value stored in the thread-local `errno` is the *native* OS's
+// number, while `libc::E*` in a Linux-musl build still holds the
+// Linux-musl compile-time values. Those disagree (e.g. EAGAIN=11 on
+// Linux, 35 on macOS), which makes std's match-on-errno misclassify
+// errors across the board (see F-002 in FINDINGS.md).
+//
+// Cosmo's libc exposes every errno name as `extern const errno_t X`
+// populated at load time with the host OS's actual value. Under
+// cfg(cosmo) we read those instead of the compile-time libc::E*.
+#[cfg(cosmo)]
+unsafe extern "C" {
+    #[link_name = "E2BIG"]       static COSMO_E2BIG: libc::c_int;
+    #[link_name = "EACCES"]      static COSMO_EACCES: libc::c_int;
+    #[link_name = "EADDRINUSE"]  static COSMO_EADDRINUSE: libc::c_int;
+    #[link_name = "EADDRNOTAVAIL"] static COSMO_EADDRNOTAVAIL: libc::c_int;
+    #[link_name = "EAGAIN"]      static COSMO_EAGAIN: libc::c_int;
